{
  "name": "@klyr/api",
  "version": "0.1.0",
  "private": true,
  "description": "Klyr backend: NestJS modular monolith (HTTP API + background worker).",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "worker": "node dist/worker.js",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@klyr/contracts": "workspace:*",
    "@klyr/core": "workspace:*",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@simplewebauthn/server": "14.0.3",
    "bullmq": "6.5.0",
    "drizzle-orm": "0.45.4",
    "ioredis": "5.8.2",
    "nodemailer": "10.0.16",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.2",
    "@types/express": "5.0.3",
    "@types/node": "22.18.12",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.15.5",
    "drizzle-kit": "0.31.11",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
