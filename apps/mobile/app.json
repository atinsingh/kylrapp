{
  "expo": {
    "name": "Klyr",
    "slug": "klyr",
    "scheme": "klyr",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "ca.klyr.app",
      "supportsTablet": false
    },
    "android": {
      "package": "ca.klyr.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#2F5E53"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
