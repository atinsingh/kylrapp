{
  "name": "@klyr/web-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Shared by the Next.js apps (web, Pro, Admin): the session-cookie proxy, server-side API calls, base styles and staff sign-in. Shipped as source; each app lists it in transpilePackages.",
  "type": "module",
  "exports": {
    "./proxy": "./src/proxy.ts",
    "./session": "./src/session.ts",
    "./styles": "./src/styles.ts",
    "./staff-sign-in": "./src/staff-sign-in.tsx"
  },
  "scripts": { "typecheck": "tsc --noEmit" },
  "dependencies": {
    "@klyr/api-client": "workspace:*",
    "@klyr/contracts": "workspace:*",
    "@klyr/tokens": "workspace:*",
    "qrcode": "1.5.4",
    "server-only": "0.0.1"
  },
  "peerDependencies": { "next": "16.4.3", "react": "19.3.1" },
  "devDependencies": {
    "@types/node": "22.18.12",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "typescript": "5.9.3"
  }
}
